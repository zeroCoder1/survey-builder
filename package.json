{
  "name": "survey-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && VITE_STORAGE=local VITE_BASE=/survey-builder/ vite build",
    "start": "npm run build && NODE_ENV=production node server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "description": "Build multi-survey questionnaires, collect or simulate responses, and export them to Excel."
}
